{
    "name": "AniTime",
    "author": "Charlie0129",
    "size": {
        "max-width": "100%",
        "width": "100%",
        "height": "280px"
    },
    "options": [
        {
            "type": "title",
            "text": "Style options"
        },
        {
            "type": "switch",
            "default": false,
            "key": "styleMediumStatic",
            "text": "Medium (static)"
        },
        {
            "type": "switch",
            "default": false,
            "key": "styleSmallStatic",
            "text": "Small (static)"
        },
        {
            "type": "switch",
            "default": true,
            "key": "styleSmallAnimated",
            "text": "Small (animated)"
        },
        {
            "type": "switch",
            "default": false,
            "key": "use12Hour",
            "text": "12-hour clock"
        },
        {
            "type": "switch",
            "default": false,
            "key": "showSeconds",
            "text": "Show seconds"
        },
        {
            "type": "switch",
            "default": false,
            "key": "showBackground",
            "text": "Show background"
        },
        {
            "type": "slider",
            "default": 1.5,
            "key": "zoomLevel",
            "text": "Zoom x",
            "min": 0.5,
            "max": 3.0,
            "step": 0.1
        },
        {
            "type": "slider",
            "default": 0,
            "key": "timeZoneOffset",
            "text": "Time zone offset (hours)",
            "min": -12,
            "max": 14,
            "step": 1
        },
        {
            "type": "slider",
            "default": 40,
            "key": "widgetTopPosition",
            "text": "Widget Position Y",
            "min": 0,
            "max": 300,
            "step": 1
        }
    ]
}
